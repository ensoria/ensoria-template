TESTING_VAR=testing_value
HTTP_PORT=8080
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=ensoria
# Read replica (optional — omit if not using a read replica)
# DB_READ_HOST=replica-host
# DB_READ_PORT=5432
# DB_READ_USER=readonly_user
# DB_READ_PASSWORD=secret
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_USER=redis
CACHE_PASSWORD=secret
CACHE_TLS=false
LOG_LEVEL=debug
# Container registry (used by `encli build image`; tag defaults to commit ID at push time).
# One pair per build target: server / scheduler / cli / <custom cmd name>.
# Key format: CONTAINER_REGISTRY_<TARGET>_LOCAL_IMAGE_NAME and CONTAINER_REGISTRY_<TARGET>_URI
CONTAINER_REGISTRY_SERVER_LOCAL_IMAGE_NAME=app_name1-server
CONTAINER_REGISTRY_SERVER_URI=000000000000.dkr.ecr.ap-northeast-1.amazonaws.com/app_name1-server
CONTAINER_REGISTRY_SCHEDULER_LOCAL_IMAGE_NAME=app_name1-scheduler
CONTAINER_REGISTRY_SCHEDULER_URI=000000000000.dkr.ecr.ap-northeast-1.amazonaws.com/app_name1-scheduler
CONTAINER_REGISTRY_CLI_LOCAL_IMAGE_NAME=app_name1-cli
CONTAINER_REGISTRY_CLI_URI=000000000000.dkr.ecr.ap-northeast-1.amazonaws.com/app_name1-cli

# --- Authentication ---
# Local development default: a shared secret so the application boots and admin
# endpoints can be called with a self-signed token. The value below is public
# (it ships with the template), so the application refuses to start with it in
# any environment other than local/test. Replace it, or switch to AUTH_MODE=jwks.
AUTH_MODE=hs256
AUTH_SECRET=ensoria-local-development-secret-change-me
# AUTH_ISSUER and AUTH_AUDIENCE are checked against the token claims when set.
# AUTH_ISSUER=https://issuer.example.com
# AUTH_AUDIENCE=ensoria
# JWKS mode (production): fetch the issuer's public keys instead of sharing a secret.
# AUTH_MODE=jwks
# AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# AUTH_JWKS_CACHE_TTL=15m
# API keys for machine callers (comma separated). AUTH_API_KEY_HEADER defaults to X-API-Key.
# AUTH_API_KEY_HEADER=X-API-Key
# AUTH_API_KEYS=key-one,key-two
