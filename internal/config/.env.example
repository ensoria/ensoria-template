TESTING_VAR=testing_value
HTTP_PORT=8080
# DB_DRIVER accepts postgres, mysql and sqlite. "sqlite3" is accepted as
# another spelling of sqlite and is normalized to it, so the worker and
# scheduler history databases see one name whichever you write.
# SQLite keeps its database in a file: put the path in DB_NAME, or in DB_HOST
# if DB_NAME is left unset.
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=ensoria
DB_PASSWORD=ensoria
DB_NAME=ensoria
# DB_SSL_MODE is passed to the driver unchanged, so its values are the driver's:
# postgres accepts disable/require/verify-ca/verify-full (default: disable),
# mysql accepts true/false/skip-verify/preferred (default: false).
# DB_SSL_MODE=disable
# Read replica (optional — omit if not using a read replica)
# DB_READ_HOST=replica-host
# DB_READ_PORT=5432
# DB_READ_USER=readonly_user
# DB_READ_PASSWORD=secret
#
# The worker and the scheduler each write history to a database of their own.
# Both are always built, and every field not named here falls back to the
# resolved DB_* values above — so leaving all of this out puts job history and
# run history in the main database.
# WORKER_DB_HOST=history.internal
# WORKER_DB_NAME=worker_history
# SCHEDULER_DB_NAME=scheduler_history
# Each prefix takes the same fields as DB_: DRIVER, HOST, PORT, USER, PASSWORD,
# NAME, SSL_MODE, MAX_OPEN_CONNS, MAX_IDLE_CONNS, CONN_MAX_IDLE_TIME,
# CONN_MAX_LIFETIME. Changing DRIVER also takes that driver's SSL_MODE default,
# because the two vocabularies are not interchangeable.
# --- Redis ---
# The shared connection every purpose falls back to. REDIS_HOST and REDIS_PORT
# are required; the application does not start without them.
REDIS_HOST=localhost
REDIS_PORT=6379
# Credentials are sent only when set. The Redis in compose.yaml takes no
# authentication, and sending AUTH to a server without one is an error, so leave
# these out for local development.
# REDIS_USER=app
# REDIS_PASSWORD=secret
# REDIS_TLS is three-state: unset inherits, true and false are explicit. A
# purpose can turn TLS off while the base leaves it on, and the other way round.
REDIS_TLS=false
#
# Each purpose overrides only what differs, under its own prefix. Everything not
# named here comes from REDIS_* above.
# REDIS_DB is deliberately not a key: the database number never falls back, so
# that the cache's eviction policy can never drop a queued job or a held lock.
# WORKER_REDIS_DB=0           # the job queue
# SCHEDULER_REDIS_DB=1        # distributed locks, recovery and control state
# CACHE_REDIS_DB=2            # the L2 cache
# AUTH_KEYSTORE_REDIS_DB=3    # API keys, when AUTH_KEYSTORE=redis
#                             # A key is stored by fingerprint, never as itself:
#                             # the record lives at auth:apikey:<sha256 hex of
#                             # the key> and holds {"sub":"...","scopes":[...]}.
#                             # So a dump of this database contains nothing
#                             # anyone can authenticate with — and nothing can
#                             # recover a key, so show it to its owner once.
#                             # AUTH_KEYSTORE=db keeps the same records in
#                             # ensoria_api_keys instead, on the connection
#                             # AUTH_KEYSTORE_DB_* names. Create the table with
#                             # `encli auth keystore init`: it belongs to the
#                             # framework, so no migration carries it.
#                             # To verify keys with code of your own instead,
#                             # set AUTH_API_KEYS_EXTERNAL=true and hand the
#                             # verifier an authkit.KeyStore
#                             # (see NewVerifier in internal/app/auth).
# AUTH_SESSION_REDIS_DB=4     # browser sessions, when AUTH_SESSION_STORE=redis
#                             # An evicted session is a signed-out user, so keep
#                             # this off an instance with an eviction policy —
#                             # or give sessions an instance of their own.
#
# Moving one purpose to its own instance keeps the base credentials:
# WORKER_REDIS_HOST=queue.internal
# WORKER_REDIS_PORT=6380
#
# The in-process L1 in front of the Redis L2.
# CACHE_OTTER_MAX_ENTRIES=1000   # entry count at which L1 starts evicting
# CACHE_NEAR_TTL=5s              # how long a value may live in L1
LOG_LEVEL=debug
# --- CORS ---
# Nothing here is required. An application whose frontend is served from this
# same origin, or that has no browser callers at all, leaves all of it unset.
#
# ⚠ CORS_ALLOW_ORIGIN=* and cookie authentication (AUTH_SESSION_STORE below)
# cannot be combined, and the application refuses to start with both: a
# wildcard says every site is this application's frontend, and the browser
# attaches the session cookie to their requests too. The same list also decides
# which origins may send a state-changing request at all — the cross-origin
# check reads this setting rather than one of its own, so the two cannot
# disagree.
# CORS_ALLOW_ORIGIN=https://app.example.com     # comma-separated for several
# CORS_ALLOW_CREDENTIALS=true                   # required for cookies to cross origins
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_ALLOW_HEADERS=Content-Type,Authorization
# CORS_EXPOSE_HEADERS=X-Request-Id
# CORS_MAX_AGE=600
# Container registry (used by `encli build image`; tag defaults to commit ID at push time).
# One pair per build target: server / scheduler / cli / <custom cmd name>.
# Key format: CONTAINER_REGISTRY_<TARGET>_LOCAL_IMAGE_NAME and CONTAINER_REGISTRY_<TARGET>_URI
CONTAINER_REGISTRY_SERVER_LOCAL_IMAGE_NAME=app_name1-server
CONTAINER_REGISTRY_SERVER_URI=000000000000.dkr.ecr.ap-northeast-1.amazonaws.com/app_name1-server
CONTAINER_REGISTRY_SCHEDULER_LOCAL_IMAGE_NAME=app_name1-scheduler
CONTAINER_REGISTRY_SCHEDULER_URI=000000000000.dkr.ecr.ap-northeast-1.amazonaws.com/app_name1-scheduler
CONTAINER_REGISTRY_CLI_LOCAL_IMAGE_NAME=app_name1-cli
CONTAINER_REGISTRY_CLI_URI=000000000000.dkr.ecr.ap-northeast-1.amazonaws.com/app_name1-cli

# --- Authentication ---
# Local development default: a shared secret so the application boots and admin
# endpoints can be called with a self-signed token. The value below is public
# (it ships with the template), so the application refuses to start with it in
# any environment other than local/test. Replace it, or switch to AUTH_MODE=jwks.
AUTH_MODE=hs256
AUTH_SECRET=ensoria-local-development-secret-change-me
# AUTH_ISSUER and AUTH_AUDIENCE are checked against the token claims when set.
# AUTH_ISSUER=https://issuer.example.com
# AUTH_AUDIENCE=ensoria
# JWKS mode (production): fetch the issuer's public keys instead of sharing a secret.
# AUTH_MODE=jwks
# AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# AUTH_JWKS_CACHE_TTL=15m
# API keys for machine callers (comma separated). AUTH_API_KEY_HEADER defaults to X-API-Key.
# The key below is public for the same reason as AUTH_SECRET, and is refused
# outside local/test. POST /order/payment-callback accepts only this scheme.
# AUTH_API_KEY_HEADER=X-API-Key
AUTH_API_KEYS=ensoria-local-development-api-key-change-me
# --- Browser sessions (cookie authentication) ---
# Naming a store turns it on; leaving AUTH_SESSION_STORE unset is how an
# application whose callers are all services says so. A browser posts its token
# once to POST /session and is served by cookie afterwards; DELETE /session
# ends the session on the server, so signing out takes effect everywhere at
# once instead of when a token would have expired.
#
# ⚠ An application that does not use this also drops the blank import of
# internal/app/auth/api from internal/app/bootstrap/server. Keeping the
# endpoints while unsetting the store is refused at startup, because they would
# answer 503 to every sign-in.
#
# redis is the one to deploy: every process sees the same sessions, so a logout
# reaches all of them. memory keeps sessions in the process and is refused
# outside local and test.
# AUTH_SESSION_STORE=redis
# The cookie. HttpOnly, Path=/ and the absence of Domain are fixed and are not
# settings — none of the three has a development use, and each one widens what
# a stolen cookie can reach.
# AUTH_SESSION_COOKIE_NAME=__Host-session    # the prefix is enforced by the browser
# AUTH_SESSION_COOKIE_SAME_SITE=lax          # lax or strict; none is not offered
# The two lifetime profiles and the idle limit both are subject to. A session
# ends at whichever deadline comes first.
# ⚠ AUTH_SESSION_IDLE_TTL caps the persistent profile in practice: shortening
# it to an hour leaves "keep me signed in" keeping nobody signed in.
# AUTH_SESSION_ABSOLUTE_TTL=12h
# AUTH_SESSION_PERSISTENT_ABSOLUTE_TTL=720h
# AUTH_SESSION_IDLE_TTL=168h
# Dropping Secure is for developing over plain HTTP — Safari has no
# http://localhost exemption, and a phone on a LAN address has none either. It
# has to be set together with a name that has no __Host- prefix, because
# browsers refuse a __Host- cookie without Secure and refuse it silently.
# Both are refused outside local and test.
# AUTH_SESSION_COOKIE_INSECURE=true
# AUTH_SESSION_COOKIE_NAME=session

# --- gRPC server ---
# Whether this application serves gRPC at all is decided in code, by whether
# cmd/server registers the gRPC app — there is no GRPC_ENABLED, the same as
# there is no flag for the worker or the scheduler. Nothing below is required.
# GRPC_PORT=50051
# GRPC_REFLECTION is three-state: unset serves reflection in local and
# development only, true and false decide it outright. It publishes the service
# definitions, so turn it on deliberately outside development.
# GRPC_REFLECTION=false
# A gRPC-specific grace period for in-flight calls. Unset, the shutdown is
# bounded by the application's own stop deadline.
# GRPC_GRACEFUL_STOP_TIMEOUT=10s
# Message size caps, in bytes. Unset leaves grpc-go's own (4 MiB received).
# GRPC_MAX_RECV_MSG_SIZE=8388608
# GRPC_MAX_SEND_MSG_SIZE=8388608
# Keepalive: how long a connection may idle before the server pings, and how
# long it waits for the answer. MIN_TIME and PERMIT_WITHOUT_STREAM are the
# client-side limits that go with them. Unset leaves grpc-go's own.
# GRPC_KEEPALIVE_TIME=2h
# GRPC_KEEPALIVE_TIMEOUT=20s
# GRPC_KEEPALIVE_MIN_TIME=5m
# GRPC_KEEPALIVE_PERMIT_WITHOUT_STREAM=false
# The share of successful calls that reach the log, 0-1. Failures are always
# logged. Which headers are logged and masked is application policy and stays in
# internal/app/grpc/log_config.go.
# GRPC_LOG_SUCCESS_SAMPLE_RATE=0.3
# GRPC_LOG_MAX_HEADER_VALUE_LEN=64

# --- Message broker ---
# The broker the subscriptions and publications use. Leave BROKER_TYPE empty in
# an application that neither publishes nor subscribes; nothing else is required.
# BROKER_URL carries no credentials on purpose: it is the part safe to show in a
# log line or a generated AsyncAPI document. Put the secrets in the keys below.
BROKER_TYPE=rabbitmq
BROKER_URL=amqp://localhost:5672/
BROKER_USER=myuser
BROKER_PASSWORD=mypassword
# NATS authenticates with a token instead of a user and password.
# BROKER_TOKEN=
# Kafka / Redpanda SASL: PLAIN, SCRAM-SHA-256 or SCRAM-SHA-512.
# BROKER_SASL_MECHANISM=
# The queue an SQS subscriber reads. Publishing does not need it.
# BROKER_QUEUE_NAME=
